<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/obsidian" android:keepScreenOn="false">
    <LinearLayout android:id="@+id/studioScreen" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ru.example.meetingrecorder.RecorderInstrumentView android:id="@+id/instrument" android:layout_width="match_parent" android:layout_height="match_parent"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="8dp" android:text="AUREL" android:fontFamily="@font/aurel_serif" android:textColor="@color/brass" android:textSize="17sp" android:letterSpacing="0.25" android:importantForAccessibility="no"/>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="8dp">
            <ImageButton android:id="@+id/btnArchive" style="@style/AurelIconButton" android:src="@drawable/ic_archive" android:contentDescription="@string/open_archive"/>
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <ImageButton android:id="@+id/btnMarker" style="@style/AurelIconButton" android:src="@drawable/ic_marker" android:contentDescription="@string/add_marker"/>
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <ru.example.meetingrecorder.RecordControlView android:id="@+id/btnRecord" android:layout_width="64dp" android:layout_height="64dp" android:contentDescription="@string/btn_record"/>
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <ImageButton android:id="@+id/btnStop" style="@style/AurelIconButton" android:src="@drawable/ic_stop" android:contentDescription="@string/btn_stop"/>
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <ImageButton android:id="@+id/btnInfo" style="@style/AurelIconButton" android:src="@drawable/ic_info" android:contentDescription="@string/about_app"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/archiveScreen" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="20dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageButton android:id="@+id/btnStudio" style="@style/AurelIconButton" android:src="@drawable/ic_back" android:contentDescription="@string/open_studio"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/list_header" android:textColor="@color/ivory" android:textSize="32sp" android:fontFamily="@font/aurel_serif"/>
            <TextView android:id="@+id/tvFileCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/brass" android:textSize="12sp"/>
        </LinearLayout>
        <EditText android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/search_field" android:hint="@string/search_hint" android:contentDescription="@string/search_hint" android:textSize="12sp" android:textColor="@color/ivory" android:textColorHint="@color/muted" android:inputType="text" android:maxLines="1" android:imeOptions="actionSearch" android:drawableStart="@drawable/ic_search" android:drawablePadding="10dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAll" style="@style/AurelTextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/all_recordings"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnFavorites" style="@style/AurelTextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/favorites"/>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvRecordings" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="16dp" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:text="@string/list_empty" android:textColor="@color/muted" android:textSize="20sp" android:fontFamily="@font/aurel_serif" android:padding="24dp"/>
        </FrameLayout>
        <LinearLayout android:id="@+id/playerPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/tvPlaying" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ivory" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical">
                <ImageButton android:id="@+id/btnPlayPause" style="@style/AurelIconButton" android:src="@drawable/ic_pause" android:contentDescription="@string/btn_pause"/>
                <TextView android:id="@+id/tvPlayTime" android:layout_width="48dp" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/brass"/>
                <SeekBar android:id="@+id/seekPlayback" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:contentDescription="@string/playback_position"/>
                <ImageButton android:id="@+id/btnClosePlayer" style="@style/AurelIconButton" android:src="@drawable/ic_close" android:contentDescription="@string/close_player"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
